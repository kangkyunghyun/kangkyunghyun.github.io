---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { excerptOf, imageOf } from '../lib/content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'medium' });

const counts = new Map<string, number>();
for (const p of posts)
	for (const t of p.data.tags ?? []) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const blogUrl = new URL('/blog/', Astro.site).href;
const schema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: '강경현 블로그',
	description: '개발하며 겪은 문제와 그때 내린 결정을 기록합니다.',
	url: blogUrl,
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: posts.map((post, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			url: new URL(`/posts/${post.id}/`, Astro.site).href,
			name: post.data.title,
		})),
	},
};
---

<Base
	title="블로그 — 강경현"
	description="개발하며 겪은 문제와 그때 내린 결정을 기록합니다."
	schema={schema}
>
	{/* 화면에는 필터 줄이 제목 자리를 대신한다. 문서 구조상 제목은 있어야 한다 */}
	<h1 class="sr">블로그</h1>

	<nav class="filters" aria-label="분류">
		<button type="button" data-tag="" aria-pressed="true">전체</button>
		{
			tags.map(([t]) => (
				<button type="button" data-tag={t} aria-pressed="false">
					{t}
				</button>
			))
		}
	</nav>

		<p class="count" data-count>전체 {posts.length}편</p>
		{
			posts.length === 0 ? (
				<div class="card empty">아직 글이 없습니다.</div>
			) : (
				<div class="card list">
					{posts.map((post) => {
						const src = imageOf(post.body);
						const excerpt = excerptOf(post.body, 96);
						return (
							<a
								href={`/posts/${post.id}`}
								class="row"
								data-tags={(post.data.tags ?? []).join(' ')}
							>
								<span class="body">
									<span class="meta">
										{(post.data.tags ?? []).map((t) => (
											<span class="tag">{t}</span>
										))}
										<time datetime={post.data.date.toISOString()}>
											{fmt.format(post.data.date)}
										</time>
									</span>
									<span class="t">{post.data.title}</span>
									{excerpt && <span class="ex">{excerpt}</span>}
								</span>
								<span class="thumb">
									{src && <img src={src} alt="" loading="lazy" />}
								</span>
							</a>
						);
					})}
				</div>
			)
		}
</Base>

<script>
	const rows = [...document.querySelectorAll<HTMLElement>('.row')];
	const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
	const count = document.querySelector('[data-count]');

	const apply = (tag: string) => {
		let shown = 0;
		for (const r of rows) {
			const ok = !tag || (r.dataset.tags ?? '').split(' ').includes(tag);
			r.classList.toggle('off', !ok);
			// 구분선은 DOM 순서로 그려지므로 첫 '보이는' 행에서 직접 끈다
			r.toggleAttribute('data-first', ok && shown === 0);
			if (ok) shown++;
		}
		for (const b of btns)
			b.setAttribute('aria-pressed', String(b.dataset.tag === tag));
		if (count) count.textContent = `${tag || '전체'} ${shown}편`;
	};

	for (const b of btns)
		b.addEventListener('click', () => apply(b.dataset.tag ?? ''));
	apply('');
</script>

<style>
	/* 시각적으로만 숨긴다. 스크린 리더에는 제목이 남아야 한다 */
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* 분류 — 목록 위 한 줄. 활성 하나만 채우고 나머지는 담백하게 둔다 */
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: clamp(2.5rem, 8vh, 4rem) 0 1.5rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--line);
	}
	.filters button {
		padding: 0.45rem 0.95rem;
		border: 0;
		border-radius: 999px;
		background: none;
		color: var(--fg3);
		font: inherit;
		font-size: 0.9375rem;
		font-weight: 600;
		cursor: pointer;
		transition:
			background 140ms ease,
			color 140ms ease;
	}
	.filters button:hover {
		background: var(--line);
		color: var(--fg);
	}
	.filters button[aria-pressed='true'] {
		background: var(--fg);
		color: var(--bg);
	}

	.count {
		margin: 0 0.25rem 0.6rem;
		color: var(--fg3);
		font-size: 0.875rem;
	}

	/* 목록 — 썸네일 자리를 항상 비워 두어 제목 시작점을 맞춘다 */
	.row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 9rem;
		align-items: center;
		gap: 1.5rem;
		padding: 1.3rem 1.25rem;
		transition: background 160ms ease;
	}
	.row:hover {
		background: color-mix(in srgb, var(--fg) 4%, var(--surface));
	}
	.row.off {
		display: none;
	}
	.row[data-first]::before {
		display: none;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}
	.t {
		font-size: 1.0625rem;
		font-weight: 700;
		letter-spacing: -0.028em;
		line-height: 1.4;
	}
	/* 요약 두 줄까지. 세 줄이 되면 행 높이가 제각각이 된다 */
	.ex {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		color: var(--fg3);
		font-size: 0.9375rem;
		line-height: 1.55;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--fg3);
		font-size: 0.8125rem;
	}
	time {
		font-variant-numeric: tabular-nums;
	}
	.tag {
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: var(--line);
		color: var(--fg3);
		font-size: 0.75rem;
		font-weight: 500;
	}
	.thumb {
		width: 9rem;
		height: 5.0625rem;
		border-radius: 12px;
		overflow: hidden;
		background: var(--surface);
	}
	.thumb:empty {
		background: none;
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}


	.empty {
		padding: 2rem 1.25rem;
		color: var(--fg3);
		text-align: center;
	}

	/* 띄울 자리가 없으면 목록 위 가로줄로 되돌린다 */
	@media (max-width: 34rem) {
		.row {
			grid-template-columns: minmax(0, 1fr) 5.25rem;
			gap: 0.9rem;
			padding: 1.05rem 1.1rem;
		}
		.thumb {
			width: 5.25rem;
			height: 3.9375rem;
		}
		.ex {
			-webkit-line-clamp: 3;
			font-size: 0.875rem;
		}
	}
</style>
