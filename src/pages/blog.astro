---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'medium' });

/** 본문 첫 이미지를 썸네일로 쓴다. 없으면 자리만 비운다 */
const thumbOf = (body = '') =>
	body.match(/!\[[^\]]*\]\((\/images\/[^)\s]+)\)/)?.[1] ?? null;

/** 목록에 보일 한 줄 요약. 본문 첫 문단에서 만든다 */
const excerptOf = (body = '') => {
	const clean = (l: string) =>
		l
			.replace(/!\[[^\]]*\]\([^)]*\)/g, '')
			.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
			.replace(/[*_`]/g, '')
			.trim();

	const text = body
		.replace(/<!--[\s\S]*?-->/g, '')
		.replace(/```[\s\S]*?```/g, '')
		.split('\n')
		.map((l) => l.trim())
		// 제목·인용·목록·이미지·구분선·맨 URL 줄은 건너뛴다
		.filter((l) => l && !/^([#>|\-*]|!\[|\[!|---|https?:\/\/)/.test(l))
		// 이미지 바로 아래 캡션은 짧다. 요약이 될 만한 길이만 고른다
		.map(clean)
		.find(
			(l) =>
				l.length >= 25 &&
				// 링크만 있던 줄은 벗겨내면 URL 문자열만 남는다
				!/^https?:\/\//.test(l) &&
				// 대회 글 머리의 일정 표기는 요약이 아니다
				!/^(시작|종료|기간|일시|장소)\s*[::]/.test(l) &&
				// 괄호로만 된 편집 노트도 마찬가지
				!/^[(（].*[)）]$/.test(l),
		);

	if (!text) return '';
	return text.length > 96 ? `${text.slice(0, 96)}…` : text;
};

const counts = new Map<string, number>();
for (const p of posts)
	for (const t of p.data.tags ?? []) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base
	title="블로그 — 강경현"
	description="개발하며 겪은 문제와 그때 내린 결정을 기록합니다."
>
	<h1>블로그</h1>

	<div class="layout">
		<aside class="side">
			<p class="sidetitle">분류</p>
			<ul>
				<li>
					<button type="button" data-tag="" aria-pressed="true">
						전체<span class="n">{posts.length}</span>
					</button>
				</li>
				{
					tags.map(([t, n]) => (
						<li>
							<button type="button" data-tag={t} aria-pressed="false">
								{t}
								<span class="n">{n}</span>
							</button>
						</li>
					))
				}
			</ul>
		</aside>
		<div class="main">
			<p class="count" data-count>전체 {posts.length}편</p>
			{
				posts.length === 0 ? (
					<div class="card empty">아직 글이 없습니다.</div>
				) : (
					<div class="card list">
						{posts.map((post) => {
							const src = thumbOf(post.body);
							const excerpt = excerptOf(post.body);
							return (
								<a
									href={`/posts/${post.id}`}
									class="row"
									data-tags={(post.data.tags ?? []).join(' ')}
								>
									<span class="body">
										<span class="meta">
											{(post.data.tags ?? []).map((t) => (
												<span class="tag">{t}</span>
											))}
											<time datetime={post.data.date.toISOString()}>
												{fmt.format(post.data.date)}
											</time>
										</span>
										<span class="t">{post.data.title}</span>
										{excerpt && <span class="ex">{excerpt}</span>}
									</span>
									<span class="thumb">
										{src && <img src={src} alt="" loading="lazy" />}
									</span>
								</a>
							);
						})}
					</div>
				)
			}
		</div>

	</div>
</Base>

<script>
	const rows = [...document.querySelectorAll<HTMLElement>('.row')];
	const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
	const count = document.querySelector('[data-count]');

	const apply = (tag: string) => {
		let shown = 0;
		for (const r of rows) {
			const ok = !tag || (r.dataset.tags ?? '').split(' ').includes(tag);
			r.classList.toggle('off', !ok);
			// 구분선은 DOM 순서로 그려지므로 첫 '보이는' 행에서 직접 끈다
			r.toggleAttribute('data-first', ok && shown === 0);
			if (ok) shown++;
		}
		for (const b of btns)
			b.setAttribute('aria-pressed', String(b.dataset.tag === tag));
		if (count) count.textContent = `${tag || '전체'} ${shown}편`;
	};

	for (const b of btns)
		b.addEventListener('click', () => apply(b.dataset.tag ?? ''));
	apply('');
</script>

<style>
	h1 {
		margin: clamp(3rem, 10vh, 5.5rem) 0.25rem clamp(1.25rem, 3vh, 1.75rem);
		font-size: clamp(1.9rem, 6vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.042em;
	}

	/* 분류는 흐름에서 빼 본문 바깥에 띄운다. 가운데는 목록만 쓴다.
	   좌표 기준은 Toc 과 같다 — 본문 폭을 바꾸면 둘 다 바꾼다 */
	.side {
		position: fixed;
		top: 6.5rem;
		left: calc(50% + 28.5rem);
		width: 11rem;
		max-height: 70vh;
		overflow-y: auto;
	}
	.count {
		margin: 0 0.25rem 0.6rem;
		color: var(--fg3);
		font-size: 0.875rem;
	}

	/* 목록 — 썸네일 자리를 항상 비워 두어 제목 시작점을 맞춘다 */
	.row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 9rem;
		align-items: center;
		gap: 1.5rem;
		padding: 1.3rem 1.25rem;
		transition: background 160ms ease;
	}
	.row:hover {
		background: color-mix(in srgb, var(--fg) 4%, var(--surface));
	}
	.row.off {
		display: none;
	}
	.row[data-first]::before {
		display: none;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}
	.t {
		font-size: 1.0625rem;
		font-weight: 700;
		letter-spacing: -0.028em;
		line-height: 1.4;
	}
	/* 요약 두 줄까지. 세 줄이 되면 행 높이가 제각각이 된다 */
	.ex {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		color: var(--fg3);
		font-size: 0.9375rem;
		line-height: 1.55;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--fg3);
		font-size: 0.8125rem;
	}
	time {
		font-variant-numeric: tabular-nums;
	}
	.tag {
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: var(--line);
		color: var(--fg3);
		font-size: 0.75rem;
		font-weight: 500;
	}
	.thumb {
		width: 9rem;
		height: 5.0625rem;
		border-radius: 12px;
		overflow: hidden;
		background: var(--surface);
	}
	.thumb:empty {
		background: none;
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* 분류 */
	.sidetitle {
		margin: 0 0 0.55rem 0.6rem;
		color: var(--fg3);
		font-size: 0.8125rem;
		font-weight: 600;
	}
	.side ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	.side button {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
		padding: 0.4rem 0.6rem;
		border: 0;
		border-radius: 8px;
		background: none;
		color: var(--fg2);
		font: inherit;
		font-size: 0.9375rem;
		text-align: left;
		cursor: pointer;
		transition:
			background 140ms ease,
			color 140ms ease;
	}
	.side button:hover {
		background: var(--line);
		color: var(--fg);
	}
	.side button[aria-pressed='true'] {
		background: var(--line);
		color: var(--fg);
		font-weight: 700;
	}
	.n {
		color: var(--fg3);
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
		font-weight: 500;
	}

	.empty {
		padding: 2rem 1.25rem;
		color: var(--fg3);
		text-align: center;
	}

	/* 띄울 자리가 없으면 목록 위 가로줄로 되돌린다 */
	@media (max-width: 84rem) {
		.side {
			position: static;
			width: auto;
			max-height: none;
			margin-bottom: 1.25rem;
		}
		.sidetitle {
			display: none;
		}
		.side ul {
			flex-direction: row;
			overflow-x: auto;
			padding-bottom: 0.2rem;
		}
		.side button {
			width: auto;
			flex-shrink: 0;
			border: 1px solid var(--line);
		}
	}
	@media (max-width: 34rem) {
		.row {
			grid-template-columns: minmax(0, 1fr) 5.25rem;
			gap: 0.9rem;
			padding: 1.05rem 1.1rem;
		}
		.thumb {
			width: 5.25rem;
			height: 3.9375rem;
		}
		.ex {
			-webkit-line-clamp: 3;
			font-size: 0.875rem;
		}
	}
</style>
