---
import Base from '../layouts/Base.astro';

const now = [
	['AI·SW 마에스트로', '17기'],
	['GDG on Campus KHU', '오거나이저'],
	['경희대 컴퓨터공학과', '2022 —'],
];

const projects = [
	{
		name: 'LinKHU',
		desc: '경희대 웹서비스를 한곳에서 쓰게 만든 브라우저 확장',
		note: '일 사용자 100명+',
		href: 'https://github.com/kangkyunghyun/LinKHU',
	},
	{
		name: 'WAVI',
		desc: 'AI 습관관리 서비스 백엔드',
		note: '6인 팀 프로젝트',
		href: 'https://github.com/kangkyunghyun/WAVI-BE',
	},
];

const certs = [
	['SQLD', '2026'],
	['정보처리기사', '2023'],
];

const links = [
	['GitHub', 'github.com/kangkyunghyun', 'https://github.com/kangkyunghyun'],
	['이전 블로그', 'khyunx.tistory.com · 348편', 'https://khyunx.tistory.com'],
];
---

<Base title="소개 — 강경현" description="강경현. 경희대학교 컴퓨터공학과.">
	<section class="hero">
		<h1>강경현</h1>
		<p>
			경희대학교 컴퓨터공학과 3학년. 알고리즘과 시스템 보안을 주로 파고, 만든
			걸 실제로 누가 쓰게 만드는 일을 좋아합니다.
		</p>
	</section>

	<p class="label">지금</p>
	<div class="card">
		{
			now.map(([k, v]) => (
				<div class="row">
					<span class="k">{k}</span>
					<span class="v">{v}</span>
				</div>
			))
		}
	</div>

	<p class="label">만든 것</p>
	<div class="card">
		{
			projects.map((p) => (
				<a href={p.href} class="row proj">
					<span class="body">
						<span class="k">
							{p.name}
							<span class="note">{p.note}</span>
						</span>
						<span class="desc">{p.desc}</span>
					</span>
					<span class="chev" aria-hidden="true">
						›
					</span>
				</a>
			))
		}
	</div>

	<p class="label">자격</p>
	<div class="card">
		{
			certs.map(([k, v]) => (
				<div class="row">
					<span class="k">{k}</span>
					<span class="v">{v}</span>
				</div>
			))
		}
	</div>

	<p class="label">링크</p>
	<div class="card">
		{
			links.map(([k, v, href]) => (
				<a href={href} class="row">
					<span class="body">
						<span class="k">{k}</span>
						<span class="desc">{v}</span>
					</span>
					<span class="chev" aria-hidden="true">
						›
					</span>
				</a>
			))
		}
	</div>
</Base>

<style>
	.hero {
		padding: clamp(3rem, 10vh, 5.5rem) 0.25rem clamp(1rem, 3vh, 2rem);
	}
	.hero h1 {
		margin: 0 0 1rem;
		font-size: clamp(1.9rem, 6vw, 2.5rem);
		letter-spacing: -0.042em;
	}
	.hero p {
		margin: 0;
		max-width: 30rem;
		color: var(--fg3);
		font-size: 0.9375rem;
	}

	.row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1.05rem 1.25rem;
	}
	a.row {
		transition: background 160ms ease;
	}
	a.row:hover {
		background: color-mix(in srgb, var(--fg) 4%, var(--surface));
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.k {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 600;
		letter-spacing: -0.024em;
	}
	.note {
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--blue) 12%, transparent);
		color: var(--blue);
		font-size: 0.75rem;
		font-weight: 600;
	}
	.v,
	.desc {
		color: var(--fg3);
		font-size: 0.875rem;
	}
	.v {
		flex-shrink: 0;
		font-variant-numeric: tabular-nums;
	}
	.chev {
		flex-shrink: 0;
		color: var(--fg3);
		font-size: 1.35rem;
		line-height: 1;
	}

	@media (max-width: 26rem) {
		.proj .k {
			flex-wrap: wrap;
		}
	}
</style>
