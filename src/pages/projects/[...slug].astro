---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content, headings } = await render(p);
const d = p.data;
const hasCompare = d.asIs.length > 0 || d.toBe.length > 0;
---

<Base title={`${d.title} — 강경현`} description={d.summary}>
	<Toc headings={headings} />
	<article>
		<header class="head">
			{
				d.logo && (
					<img
						class="logo"
						src={`/logos/${d.logo}`}
						alt=""
						width="64"
						height="64"
					/>
				)
			}
			<p class="wordmark">{d.title}</p>
			<h1>{d.summary}</h1>
			{
				(d.live || d.badge) && (
					<p class="badges">
						{d.live && <span class="live">운영 중</span>}
						{d.badge && <span class="note">{d.badge}</span>}
					</p>
				)
			}
			<dl class="meta">
				<div><dt>기간</dt><dd>{d.period}</dd></div>
				<div><dt>역할</dt><dd>{d.role}</dd></div>
				{d.team && <div><dt>팀</dt><dd>{d.team}</dd></div>}
			</dl>
			{
				d.links.length > 0 && (
					<p class="links">
						{d.links.map((l) => (
							<a
								href={l.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								{l.label} <span aria-label="새 창에서 열림">↗</span>
							</a>
						))}
					</p>
				)
			}
		</header>

		{
			hasCompare && (
				<section class="compare">
					<h2>AS-IS → TO-BE</h2>
					<div class="two">
						<div>
							<h3>AS-IS</h3>
							<ul>
								{d.asIs.map((x) => (
									<li>{x}</li>
								))}
							</ul>
						</div>
						<div>
							<h3>TO-BE</h3>
							<ul>
								{d.toBe.map((x) => (
									<li>{x}</li>
								))}
							</ul>
						</div>
					</div>
				</section>
			)
		}

		<Content />

		{
			d.stack.length > 0 && (
				<section>
					<h2>기술 스택</h2>
					<p class="chips">
						{d.stack.map((s) => (
							<span class="chip">{s}</span>
						))}
					</p>
				</section>
			)
		}
	</article>

	<a href="/#projects" class="back">프로젝트 목록으로</a>
</Base>

<style>
	article,
	.back {
		max-width: var(--measure);
		margin-inline: auto;
	}

	.head {
		padding: clamp(2.5rem, 8vh, 4rem) 0 2rem;
	}
	.head .logo {
		display: block;
		width: 64px;
		height: 64px;
		margin-bottom: 1rem;
		border-radius: 16px;
		object-fit: cover;
	}
	.wordmark {
		margin: 0;
		font-size: clamp(2rem, 7vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 1.1;
	}
	.head h1 {
		margin: 0.75rem 0 0;
		font-size: clamp(1.25rem, 3.4vw, 1.6rem);
		letter-spacing: -0.035em;
	}
	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.9rem 0 0;
	}
	.note {
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--blue) 12%, transparent);
		color: var(--blue-strong);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.live {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.1rem 0.6rem 0.1rem 0.45rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--green) 12%, transparent);
		color: var(--green);
		font-size: 0.875rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.live::before {
		content: '';
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: currentColor;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.5rem 0 0;
	}
	.meta div {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		background: var(--surface);
	}
	.meta dt {
		color: var(--fg3);
		font-size: 0.75rem;
		font-weight: 700;
	}
	.meta dd {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 500;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 1.25rem 0 0;
	}
	.links a {
		color: var(--blue-strong);
		font-size: 0.9375rem;
		font-weight: 600;
	}

	article :global(h2) {
		margin: 3rem 0 1rem;
		font-size: 1.25rem;
	}
	.compare h2 {
		margin: 3rem 0 1rem;
		font-size: 1.25rem;
	}
	.two {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.6rem;
	}
	.two > div {
		padding: 1.1rem 1.25rem;
		border-radius: var(--r);
		background: var(--surface);
	}
	.two h3 {
		margin: 0 0 0.6rem;
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}
	.two ul {
		margin: 0;
		padding-left: 1.1rem;
	}
	.two li {
		color: var(--fg2);
		font-size: 0.9375rem;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.chip {
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		background: var(--surface);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.back {
		display: block;
		margin-top: 3.5rem;
		padding: 1rem;
		border-radius: 14px;
		background: var(--surface);
		color: var(--fg2);
		font-size: 0.9375rem;
		font-weight: 600;
		text-align: center;
	}

	@media (max-width: 34rem) {
		.two {
			grid-template-columns: 1fr;
		}
	}
</style>
