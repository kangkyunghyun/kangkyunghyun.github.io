---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';

// 프로젝트는 src/content/projects/*.md 가 원본이다
const projects = (
	await getCollection('projects', ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);

// 출처: github.com/kangkyunghyun 프로필 README
const education = [
	{
		period: '2022.03 — 현재',
		title: '경희대학교',
		aside: '컴퓨터공학과',
		desc: 'GPA 4.09 / 4.5',
	},
];

const activity = [
	{
		period: '2026.03 — 현재',
		title: 'AI·SW 마에스트로',
		aside: '17기',
		href: 'https://github.com/AI-SW-Maestro-OSS',
	},
	{
		period: '2026.03 — 2026.06',
		title: '경희대학교 알고리즘 멘토',
	},
	{
		period: '2025.09 — 현재',
		title: 'HacKHU',
		aside: '경희대 해킹 동아리',
	},
	{
		period: '2025.09 — 현재',
		title: 'KHUA',
		aside: '경희대 알고리즘 동아리',
	},
	{
		period: '2025.09 — 2026.02',
		title: 'GDG on Campus 경희대학교',
		href: 'https://github.com/GDG-on-Campus-KHU',
	},
];

const awards = [
	{
		period: '2026.05',
		title: '2026 경희대학교 봄 프로그래밍 경시대회',
		aside: '우수상 (3등)',
	},
	{
		period: '2026.05',
		title: '2026 SCSC computer programming contest Div.3',
		aside: 'Furiosa Prize (4등)',
	},
	{
		period: '2025.10',
		title: '2025 경희대학교 가을 프로그래밍 경시대회',
		aside: '장려상 (4등)',
	},
	{
		period: '2022.09',
		title: '2022 경희대학교 동아리 단합 공모전',
		aside: '장려상 (3등)',
	},
];

const certs = [
	{ period: '2026.05', title: 'TOPCIT', aside: '수준 4 (672점)' },
	{ period: '2026.03', title: 'SQLD' },
	{ period: '2023.04', title: '정보처리기능사' },
];

// 출처: 노션 개인 소개 페이지 ▶ Tech Stacks
const stacks = [
	['Backend', ['Java', 'Spring Boot']],
	['Database', ['MySQL']],
	['DevOps', ['AWS', 'GCP', 'Docker', 'GitHub Actions']],
	['Problem Solving', ['C++']],
	['Tools', ['Git/GitHub', 'Swagger']],
];

const links = [
	{ icon: 'github', label: 'GitHub', href: 'https://github.com/kangkyunghyun' },
	{
		icon: 'code',
		label: 'solved.ac',
		href: 'https://solved.ac/profile/kangkh0906',
	},
	{
		icon: 'linkedin',
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/kangkyunghyun/',
	},
	{ icon: 'book', label: '이전 블로그', href: 'https://khyunx.tistory.com' },
	{ icon: 'mail', label: 'Email', href: 'mailto:kyunghyun.dev@gmail.com' },
];
---

<Base
	title="강경현"
	description="경희대학교 컴퓨터공학과. 알고리즘과 시스템 보안을 주로 파고 있습니다."
>
	<section class="hero">
		<h1>
			만든 걸 실제로 누가<br />쓰게 만드는 개발자<br /><strong>강경현</strong>입니다.
		</h1>
		<p>
			아이디어를 실제 서비스로 구현하고 사용자에게 전달하는 과정을 즐깁니다.
			경희대학교 컴퓨터공학과 3학년, 알고리즘과 시스템 보안을 주로 파고
			있습니다.
		</p>
		<nav class="btns" aria-label="외부 링크">
			{
				links.map((l) => (
					<a href={l.href} class="btn">
						<Icon name={l.icon} size={15} />
						{l.label}
					</a>
				))
			}
		</nav>
	</section>

	<section id="stacks">
		<h2>Tech Stacks</h2>
		<div class="card">
			{
				stacks.map(([field, items]) => (
					<div class="stack">
						<span class="field">{field}</span>
						<span class="chips">
							{(items as string[]).map((s) => (
								<span class="chip">{s}</span>
							))}
						</span>
					</div>
				))
			}
		</div>
	</section>

	<section id="education">
		<h2>Education</h2>
		<Timeline items={education} />
	</section>

	<section id="activity">
		<h2>Activity</h2>
		<Timeline items={activity} />
	</section>

	<section id="projects">
		<h2>Projects</h2>
		<div class="projects">
			{
				projects.map((p) => (
					<a href={`/projects/${p.id}`} class="proj">
						<span class="head">
							<span class="name">
								{p.data.title}
								{p.data.badge && <span class="note">{p.data.badge}</span>}
							</span>
							<span class="period">{p.data.period}</span>
						</span>
						<span class="role">{p.data.role}</span>
						<span class="desc">{p.data.summary}</span>
					</a>
				))
			}
		</div>
	</section>

	<section id="awards">
		<h2>Awards</h2>
		<Timeline items={awards} />
	</section>

	<section id="certifications">
		<h2>Certifications</h2>
		<Timeline items={certs} />
	</section>

</Base>

<style>
	.hero {
		padding: clamp(3.5rem, 12vh, 6.5rem) 0.25rem clamp(2rem, 6vh, 3.5rem);
	}
	.hero h1 {
		margin: 0 0 1.15rem;
		font-size: clamp(1.6rem, 5.2vw, 2.3rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.45;
	}
	.hero h1 strong {
		font-weight: 800;
	}
	.hero p {
		margin: 0;
		max-width: 30rem;
		color: var(--fg3);
		font-size: 0.9375rem;
	}
	.btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.75rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 1rem;
		border-radius: 999px;
		background: var(--surface);
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		transition: background 160ms ease, color 160ms ease;
	}
	.btn:hover {
		background: var(--blue);
		color: #fff;
		opacity: 1;
	}

	section {
		margin-bottom: 4rem;
		/* 앵커로 점프했을 때 sticky 헤더에 제목이 가리지 않게 */
		scroll-margin-top: 4.5rem;
	}
	section h2 {
		margin: 0 0 2rem;
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.035em;
		text-align: center;
	}

	.projects {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.proj {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1.15rem 1.25rem;
		border-radius: var(--r);
		background: var(--surface);
		transition: background 160ms ease;
	}
	.proj:hover {
		background: color-mix(in srgb, var(--fg) 4%, var(--surface));
	}
	.proj .head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.proj .name {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.028em;
	}
	.note {
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--blue) 12%, transparent);
		color: var(--blue);
		font-size: 0.75rem;
		font-weight: 600;
	}
	.proj .period {
		flex-shrink: 0;
		color: var(--fg3);
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
	}
	.proj .role {
		color: var(--fg3);
		font-size: 0.8125rem;
		font-weight: 600;
	}
	.proj .desc {
		margin-top: 0.3rem;
		color: var(--fg2);
		font-size: 0.9375rem;
	}

	.stack {
		display: grid;
		grid-template-columns: 9rem 1fr;
		align-items: baseline;
		gap: 1rem;
		padding: 1rem 1.25rem;
	}
	.field {
		color: var(--fg3);
		font-size: 0.8125rem;
		font-weight: 700;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.chip {
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		background: var(--bg);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1.05rem 1.25rem;
		transition: background 160ms ease;
	}
	.row:hover {
		background: color-mix(in srgb, var(--fg) 4%, var(--surface));
	}
	.row .body {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.row .k {
		font-weight: 600;
		letter-spacing: -0.024em;
	}
	.row .v {
		color: var(--fg3);
		font-size: 0.875rem;
	}
	.chev {
		flex-shrink: 0;
		color: var(--fg3);
		font-size: 1.35rem;
		line-height: 1;
	}

	@media (max-width: 30rem) {
		.proj .head {
			flex-direction: column;
			gap: 0.2rem;
		}
		.stack {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
