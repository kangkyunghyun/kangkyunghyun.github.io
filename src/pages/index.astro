---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';

// 프로젝트는 src/content/projects/*.md 가 원본이다
const projects = (
	await getCollection('projects', ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);

// 출처: github.com/kangkyunghyun 프로필 README
const education = [
	{
		period: '2022. 3. — 현재',
		title: '경희대학교',
		aside: '컴퓨터공학과',
		desc: 'GPA 4.09 / 4.5',
	},
];

const activity = [
	{
		period: '2026. 3. — 현재',
		title: 'AI·SW 마에스트로',
		href: 'https://swmaestro.ai/',
	},
	{
		period: '2026. 3. — 2026. 6.',
		title: '경희대학교 알고리즘 멘토',
	},
	{
		period: '2025. 9. — 현재',
		title: '경희대학교 해킹 동아리 HacKHU',
	},
	{
		period: '2025. 9. — 현재',
		title: '경희대학교 알고리즘 동아리 KHUA',
	},
	{
		period: '2025. 9. — 2026. 2.',
		title: 'GDG on Campus 경희대학교',
		href: 'https://github.com/GDG-on-Campus-KHU',
	},
];

const awards = [
	{
		period: '2026. 5.',
		title: '2026 경희대학교 봄 프로그래밍 경시대회',
		aside: '우수상 (3등)',
	},
	{
		period: '2026. 5.',
		title: '2026 SCSC computer programming contest Div.3',
		aside: 'Furiosa Prize (4등)',
	},
	{
		period: '2025. 10.',
		title: '2025 경희대학교 가을 프로그래밍 경시대회',
		aside: '장려상 (4등)',
	},
	{
		period: '2022. 9.',
		title: '2022 경희대학교 동아리 단합 공모전',
		aside: '장려상 (3등)',
	},
];

const certs = [
	{ period: '2026. 5.', title: 'TOPCIT', aside: '수준 4 (672점)' },
	{ period: '2026. 3.', title: 'SQLD' },
	{ period: '2023. 4.', title: '정보처리기능사' },
];

// 출처: 노션 개인 소개 페이지 ▶ Tech Stacks
const stacks = [
	['Backend', ['Java', 'Kotlin', 'Spring Boot']],
	['Database', ['MySQL', 'PostgreSQL']],
	['DevOps', ['AWS', 'GCP', 'Docker', 'GitHub Actions']],
	['Monitoring', ['Sentry', 'Amplitude']],
	['Problem Solving', ['C++']],
	['Tools', ['Git/GitHub', 'Jira', 'Swagger']],
];

// handle 은 실제 주소를 그대로 보여준다. 클릭하지 않아도 읽히게.
const links = [
	{
		icon: 'github',
		label: 'GitHub',
		handle: '@kangkyunghyun',
		href: 'https://github.com/kangkyunghyun',
	},
	{
		icon: 'linkedin',
		label: 'LinkedIn',
		handle: 'in/kangkyunghyun',
		href: 'https://www.linkedin.com/in/kangkyunghyun/',
	},
	{
		icon: 'at',
		label: 'Threads',
		handle: '@khyun_x',
		href: 'https://www.threads.com/@khyun_x',
	},
	{
		icon: 'mail',
		label: 'Email',
		handle: 'kyunghyun.dev@gmail.com',
		href: 'mailto:kyunghyun.dev@gmail.com',
	},
];
---

<Base
	title="강경현"
	description="경희대학교 컴퓨터공학과. 알고리즘과 시스템 보안을 주로 파고 있습니다."
>
	<section class="hero">
		<h1>강경현</h1>
		<p>아이디어를 실제 서비스로 구현하고 사용자에게 전달하는 과정을 즐깁니다.</p>
		<nav class="btns" aria-label="외부 링크">
			{
				links.map((l) => (
					<a href={l.href} class="btn">
						<Icon name={l.icon} size={15} />
						<span class="lb">{l.label}</span>
						<span class="hd">{l.handle}</span>
					</a>
				))
			}
		</nav>
	</section>

	<section id="projects">
		<h2>Projects</h2>
		<div class="projects">
			{
				projects.map((p) => (
					<a href={`/projects/${p.id}`} class="proj">
						{
							p.data.logo && (
								<img
									class="logo"
									src={`/logos/${p.data.logo}`}
									alt=""
									width="44"
									height="44"
									loading="lazy"
								/>
							)
						}
						<span class="body">
							<span class="head">
								<span class="name">
									{p.data.title}
									{p.data.live && <span class="live">운영 중</span>}
									{p.data.badge && <span class="note">{p.data.badge}</span>}
								</span>
								<span class="period">{p.data.period}</span>
							</span>
							<span class="role">{p.data.role}</span>
							<span class="desc">{p.data.summary}</span>
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section id="stacks">
		<h2>Tech Stacks</h2>
		<div class="card">
			{
				stacks.map(([field, items]) => (
					<div class="stack">
						<span class="field">{field}</span>
						<span class="chips">
							{(items as string[]).map((s) => (
								<span class="chip">{s}</span>
							))}
						</span>
					</div>
				))
			}
		</div>
	</section>

	<section id="activity">
		<h2>Activity</h2>
		<Timeline items={activity} />
	</section>

	<section id="education">
		<h2>Education</h2>
		<Timeline items={education} />
	</section>

	<section id="certifications">
		<h2>Certifications</h2>
		<Timeline items={certs} />
	</section>

	<section id="awards">
		<h2>Awards</h2>
		<Timeline items={awards} />
	</section>
</Base>

<style>
	.hero {
		padding: clamp(3.5rem, 12vh, 6.5rem) 0.25rem clamp(2rem, 6vh, 3.5rem);
	}
	.hero h1 {
		margin: 0 0 0.9rem;
		font-size: clamp(2.2rem, 7vw, 3.2rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 1.2;
	}
	.hero p {
		margin: 0;
		max-width: 30rem;
		color: var(--fg3);
		font-size: 0.9375rem;
	}
	.btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.75rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 0.95rem;
		border-radius: 999px;
		background: var(--surface);
		font-size: 0.875rem;
		letter-spacing: -0.02em;
		transition: background 160ms ease, color 160ms ease;
	}
	.btn .lb {
		font-weight: 700;
	}
	.btn .hd {
		color: var(--fg3);
		font-weight: 500;
		transition: color 160ms ease;
	}
	.btn:hover {
		background: var(--blue);
		color: #fff;
		opacity: 1;
	}
	.btn:hover .hd {
		color: color-mix(in srgb, #fff 80%, transparent);
	}

	section {
		margin-bottom: 4rem;
		/* 앵커로 점프했을 때 sticky 헤더에 제목이 가리지 않게 */
		scroll-margin-top: 4.5rem;
	}
	section h2 {
		margin: 0 0 2rem;
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.035em;
		text-align: center;
	}

	.projects {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.proj {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		padding: 1.15rem 1.25rem;
		border-radius: var(--r);
		background: var(--surface);
		transition: background 160ms ease;
	}
	.proj .logo {
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		border-radius: 11px;
		object-fit: cover;
	}
	.proj .body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
		flex: 1;
	}
	.proj:hover {
		background: color-mix(in srgb, var(--fg) 4%, var(--surface));
	}
	.proj .head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.proj .name {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.028em;
	}
	.note {
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--blue) 12%, transparent);
		color: var(--blue);
		font-size: 0.75rem;
		font-weight: 600;
	}
	/* 운영 상태는 성격이 달라 색을 나눈다 */
	.live {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.05rem 0.5rem 0.05rem 0.4rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--green) 12%, transparent);
		color: var(--green);
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.live::before {
		content: '';
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: currentColor;
	}
	.proj .period {
		flex-shrink: 0;
		color: var(--fg3);
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
	}
	.proj .role {
		color: var(--fg3);
		font-size: 0.8125rem;
		font-weight: 600;
	}
	.proj .desc {
		margin-top: 0.3rem;
		color: var(--fg2);
		font-size: 0.9375rem;
	}

	.stack {
		display: grid;
		grid-template-columns: 9rem 1fr;
		align-items: baseline;
		gap: 1rem;
		padding: 1rem 1.25rem;
	}
	.field {
		color: var(--fg3);
		font-size: 0.8125rem;
		font-weight: 700;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.chip {
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		background: var(--bg);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	@media (max-width: 30rem) {
		.proj .head {
			flex-direction: column;
			gap: 0.2rem;
		}
		.stack {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
