---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';

// 프로젝트는 src/content/projects/*.md 가 원본이다.
// 정렬은 period 앞머리(`YYYY. M.`)를 읽어 최신순으로 한다 —
// 수동 순번을 두면 프로젝트가 늘 때마다 손으로 맞춰야 하고 반드시 어긋난다.
const startedAt = (period: string) => {
	const m = period.match(/(\d{4})\.\s*(\d{1,2})\./);
	return m ? Number(m[1]) * 12 + Number(m[2]) : 0;
};
const projects = (
	await getCollection('projects', ({ data }) => !data.draft)
).sort(
	(a, b) =>
		startedAt(b.data.period) - startedAt(a.data.period) ||
		a.data.title.localeCompare(b.data.title),
);
const statusLabels = { live: '운영 중', paused: '운영 중단' } as const;

// 출처: github.com/kangkyunghyun 프로필 README
const education = [
	{
		period: '2022. 3. ~ 현재',
		title: '경희대학교',
		aside: '컴퓨터공학과',
		desc: 'GPA 4.09 / 4.5',
	},
];

// title 은 조직·활동명, aside 는 그 안에서의 역할(없으면 비운다),
// desc 는 그 조직이 무엇인지. 세 칸의 성격을 섞지 않는다.
const activity = [
	{
		period: '2026. 4. ~ 현재',
		title: 'AI·SW 마에스트로',
		aside: '17기 연수생',
		desc: '과학기술정보통신부 SW 인재양성 사업',
		href: 'https://swmaestro.ai/',
	},
	{
		period: '2026. 3. ~ 현재',
		title: '알고리즘 멘토',
		aside: '강의 지원',
		desc: '경희대학교 SW중심대학사업단 KHU-SW멘토',
	},
	{
		period: '2025. 9. ~ 현재',
		title: 'HacKHU',
		desc: '경희대학교 해킹 동아리',
	},
	{
		period: '2025. 9. ~ 2026. 6.',
		title: 'KHUA',
		desc: '경희대학교 알고리즘 동아리',
	},
	{
		period: '2025. 9. ~ 2026. 2.',
		title: 'GDG on Campus KHU',
		aside: '백엔드 멤버',
		desc: '경희대학교 구글 개발자 커뮤니티',
		href: 'https://github.com/GDG-on-Campus-KHU',
	},
];

const awards = [
	{
		period: '2026. 8.',
		title: '제12회 SCPC',
		aside: '본선 진출',
	},
	{
		period: '2026. 5.',
		title: '2026 경희대학교 봄 프로그래밍 경시대회',
		aside: '우수상 (3등)',
	},
	{
		period: '2026. 5.',
		title: '2026 SCSC computer programming contest Div.3',
		aside: 'Furiosa Prize (4등)',
	},
	{
		period: '2025. 10.',
		title: '2025 경희대학교 가을 프로그래밍 경시대회',
		aside: '장려상 (4등)',
	},
	{
		period: '2022. 9.',
		title: '2022 경희대학교 동아리 단합 공모전',
		aside: '장려상 (3등) · KHUromise',
		href: 'https://github.com/kangkyunghyun/khuromise',
	},
];

const certs = [
	{ period: '2026. 5.', title: 'TOPCIT', aside: '수준 4 (672점)' },
	{ period: '2026. 3.', title: 'SQLD' },
	{ period: '2023. 4.', title: '정보처리기능사' },
];

// 출처: 노션 개인 소개 페이지 ▶ Tech Stacks
const stacks = [
	['Backend', ['Kotlin', 'Java', 'Spring Boot']],
	['Database', ['PostgreSQL', 'MySQL', 'Redis']],
	['DevOps', ['AWS', 'Docker', 'Terraform', 'GitHub Actions', 'GCP']],
	['Observability', ['OpenTelemetry', 'Prometheus', 'Grafana', 'OpenSearch', 'Sentry']],
	['Problem Solving', ['C++']],
	['Analytics', ['Amplitude']],
	['Tools', ['Git/GitHub', 'Jira', 'Swagger']],
];

// handle 은 실제 주소를 그대로 보여준다. 클릭하지 않아도 읽히게.
// external: 새 탭으로 연다. mailto 는 새 탭을 열면 빈 탭이 남아 제외한다.
const links = [
	{
		icon: 'github',
		label: 'GitHub',
		handle: '@kangkyunghyun',
		href: 'https://github.com/kangkyunghyun',
		external: true,
	},
	{
		icon: 'linkedin',
		label: 'LinkedIn',
		handle: 'in/kangkyunghyun',
		href: 'https://www.linkedin.com/in/kangkyunghyun/',
		external: true,
	},
	{
		icon: 'at',
		label: 'Threads',
		handle: '@khyun_x',
		href: 'https://www.threads.com/@khyun_x',
		external: true,
	},
	{
		icon: 'mail',
		label: 'Email',
		handle: 'kyunghyun.dev@gmail.com',
		href: 'mailto:kyunghyun.dev@gmail.com',
	},
];
const homeUrl = new URL('/', Astro.site).href;
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${homeUrl}#website`,
			name: 'Kyunghyun Kang',
			alternateName: '강경현',
			url: homeUrl,
			inLanguage: 'ko-KR',
		},
		{
			'@type': 'Person',
			'@id': `${homeUrl}#person`,
			name: '강경현',
			alternateName: 'Kyunghyun Kang',
			url: homeUrl,
			jobTitle: 'Backend Engineer',
			sameAs: [
				'https://github.com/kangkyunghyun',
				'https://www.linkedin.com/in/kangkyunghyun/',
				'https://www.threads.com/@khyun_x',
			],
			affiliation: {
				'@type': 'CollegeOrUniversity',
				name: '경희대학교',
			},
		},
	],
};
---

<Base
	title="강경현"
	description="경희대학교 컴퓨터공학과. 알고리즘과 시스템 보안을 주로 파고 있습니다."
	schema={schema}
>
	<section class="hero">
		<h1>강경현</h1>
		<p class="role">Backend Engineer</p>
		<p class="lead">아이디어를 실제 서비스로 구현하고 사용자에게 전달하는 과정을 즐깁니다.</p>
		<nav class="btns" aria-label="외부 링크">
			{
				links.map((l) => (
					<a
						href={l.href}
						class="btn"
						target={l.external ? '_blank' : undefined}
						rel={l.external ? 'noopener noreferrer' : undefined}
					>
						<Icon name={l.icon} size={15} />
						<span class="lb">{l.label}</span>
						<span class="hd">{l.handle}</span>
						{l.external && <span class="ext" aria-label="새 창에서 열림">↗</span>}
					</a>
				))
			}
		</nav>
	</section>

	<section id="projects">
		<h2>Projects</h2>
		<div class="projects">
			{
				projects.map((p) => (
					<a href={`/projects/${p.id}`} class="proj">
						{
							p.data.logo && (
								<img
									class="logo"
									src={`/logos/${p.data.logo}`}
									alt=""
									width="44"
									height="44"
									loading="lazy"
								/>
							)
						}
						<span class="body">
							<span class="head">
								<span class="name">
									{p.data.title}
									{p.data.status && (
										<span class:list={['status', p.data.status]}>
											{statusLabels[p.data.status]}
										</span>
									)}
									{p.data.badge && <span class="note">{p.data.badge}</span>}
								</span>
								<span class="period">{p.data.period}</span>
							</span>
							<span class="role">{p.data.role}</span>
							<span class="desc">{p.data.summary}</span>
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section id="stacks">
		<h2>Technical Skills</h2>
		<div class="card">
			{
				stacks.map(([field, items]) => (
					<div class="stack">
						<span class="field">{field}</span>
						<span class="chips">
							{(items as string[]).map((s) => (
								<span class="chip">{s}</span>
							))}
						</span>
					</div>
				))
			}
		</div>
	</section>

	<section id="activity">
		<h2>Activities</h2>
		<Timeline items={activity} />
	</section>

	<section id="education">
		<h2>Education</h2>
		<Timeline items={education} />
	</section>

	<section id="certifications">
		<h2>Certifications</h2>
		<Timeline items={certs} />
	</section>

	<section id="awards">
		<h2>Awards</h2>
		<Timeline items={awards} />
	</section>
</Base>

<style>
	/* 포트폴리오는 훑어보는 페이지라 셸 폭을 다 쓰지 않는다 */
	section {
		max-width: 46rem;
		margin-inline: auto;
	}

	.hero {
		padding: clamp(3.5rem, 12vh, 6.5rem) 0.25rem clamp(2rem, 6vh, 3.5rem);
	}
	.hero h1 {
		margin: 0 0 0.35rem;
		font-size: clamp(2.2rem, 7vw, 3.2rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 1.2;
	}
	.hero .role {
		margin: 0 0 0.85rem;
		color: var(--fg2);
		font-size: 1.0625rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.hero .lead {
		margin: 0;
		max-width: 32rem;
		color: var(--fg3);
		font-size: 1rem;
	}
	.btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.75rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 0.95rem;
		border-radius: 999px;
		background: var(--surface);
		font-size: 0.875rem;
		letter-spacing: -0.02em;
		transition: background 160ms ease, color 160ms ease;
	}
	.btn .lb {
		font-weight: 700;
	}
	.btn .hd {
		color: var(--fg3);
		font-weight: 500;
		transition: color 160ms ease;
	}
	.btn:hover {
		background: var(--blue);
		color: #fff;
		opacity: 1;
	}
	.btn:hover .hd {
		color: color-mix(in srgb, #fff 80%, transparent);
	}
	/* 새 창으로 열린다는 표시. 없으면 맥락이 바뀐 걸 알 수 없다 */
	.btn .ext {
		margin-left: -0.1rem;
		color: var(--fg3);
		font-size: 0.75rem;
		transition: color 160ms ease;
	}
	.btn:hover .ext {
		color: color-mix(in srgb, #fff 70%, transparent);
	}

	section {
		margin-bottom: 4rem;
		/* 앵커로 점프했을 때 sticky 헤더에 제목이 가리지 않게 */
		scroll-margin-top: 4.5rem;
	}
	/* 항목 글자가 짧아 오른쪽은 어차피 빈다.
	   제목을 가운데 두면 축이 어긋나 보여 왼쪽으로 맞춘다 */
	section h2 {
		margin: 0 0 1.75rem;
		font-size: 1.75rem;
		font-weight: 800;
		letter-spacing: -0.035em;
	}

	.projects {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.proj {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		padding: 1.15rem 1.25rem;
		border-radius: var(--r);
		background: var(--surface);
		transition: background 160ms ease;
	}
	.proj .logo {
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		border-radius: 11px;
		object-fit: cover;
	}
	.proj .body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
		flex: 1;
	}
	.proj:hover {
		background: color-mix(in srgb, var(--fg) 4%, var(--surface));
	}
	.proj .head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.proj .name {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.028em;
	}
	.note {
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--blue) 12%, transparent);
		color: var(--blue-strong);
		font-size: 0.75rem;
		font-weight: 600;
	}
	/* 운영 상태는 성격이 달라 색을 나눈다 */
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.05rem 0.5rem 0.05rem 0.4rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.status::before {
		content: '';
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: currentColor;
	}
	.status.live {
		background: color-mix(in srgb, var(--green) 12%, transparent);
		color: var(--green);
	}
	.status.paused {
		background: color-mix(in srgb, var(--fg3) 12%, transparent);
		color: var(--fg3);
	}
	.proj .period {
		flex-shrink: 0;
		color: var(--fg3);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
	}
	.proj .role {
		color: var(--fg3);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.proj .desc {
		margin-top: 0.3rem;
		color: var(--fg2);
		font-size: 1rem;
	}

	.stack {
		display: grid;
		grid-template-columns: 9rem 1fr;
		align-items: baseline;
		gap: 1rem;
		padding: 1rem 1.25rem;
	}
	.field {
		color: var(--fg3);
		font-size: 0.875rem;
		font-weight: 700;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.chip {
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		background: var(--bg);
		font-size: 0.875rem;
		font-weight: 600;
	}

	@media (max-width: 30rem) {
		.proj .head {
			flex-direction: column;
			gap: 0.2rem;
		}
		.stack {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
