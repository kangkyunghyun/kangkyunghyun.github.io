---
import Icon from '../components/Icon.astro';

interface Props {
	title: string;
	description?: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
	{ href: '/', label: '포트폴리오' },
	{ href: '/blog', label: '블로그' },
];
const connect = [
	{ icon: 'github', label: 'GitHub', href: 'https://github.com/kangkyunghyun' },
	{
		icon: 'linkedin',
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/kangkyunghyun/',
	},
	{ icon: 'book', label: '블로그', href: '/blog' },
	{ icon: 'external', label: '이전 블로그', href: 'https://khyunx.tistory.com' },
	{ icon: 'mail', label: 'Email', href: 'mailto:kyunghyun.dev@gmail.com' },
];
const path = Astro.url.pathname;
// /posts/... 로 들어와도 헤더의 '블로그'가 켜져 있어야 한다
const inBlog = path === '/blog' || path.startsWith('/posts');
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="data:," />
		{/* 첫 페인트 전에 테마를 적용해야 화면이 번쩍이지 않는다 */}
		<script is:inline>
			const t = localStorage.getItem('theme');
			if (t === 'light' || t === 'dark')
				document.documentElement.dataset.theme = t;
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="bar">
				<a href="/" class="wordmark">Kyunghyun Kang</a>
				<nav>
					{
						nav.map((item) => {
							const on =
								item.href === '/blog' ? inBlog : item.href === path;
							return (
								<a
									href={item.href}
									class:list={['navlink', { on }]}
									aria-current={on ? 'page' : undefined}
								>
									{item.label}
								</a>
							);
						})
					}
					<button
						id="theme-toggle"
						type="button"
						class="navlink theme"
						aria-label="테마 변경"
					>
						<span data-theme-icon="system"><Icon name="monitor" size={16} /></span>
						<span data-theme-icon="light" hidden><Icon name="sun" size={16} /></span>
						<span data-theme-icon="dark" hidden><Icon name="moon" size={16} /></span>
					</button>
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="cols">
				<div class="intro">
					<p class="name">강경현</p>
					<p class="role">Backend Developer</p>
				</div>

				<div>
					<h2>Connect</h2>
					<ul>
						{
							connect.map((c) => (
								<li>
									<a href={c.href}>
										<Icon name={c.icon} size={15} />
										{c.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div>
					<h2>Quick Links</h2>
					<ul>
						<li><a href="/#projects">Projects</a></li>
						<li><a href="/#stacks">Tech Stacks</a></li>
						<li><a href="/#activity">Activity</a></li>
						<li><a href="/#certifications">Certifications</a></li>
						<li><a href="/#awards">Awards</a></li>
					</ul>
				</div>
			</div>
			<p class="copy">© 2026 강경현. All rights reserved.</p>
		</footer>

		<script is:inline>
			// 시스템 → 라이트 → 다크 → 시스템 순으로 순환한다.
			// 'system' 은 data-theme 을 지워서 prefers-color-scheme 에 맡긴다.
			(() => {
				const ORDER = ['system', 'light', 'dark'];
				const btn = document.getElementById('theme-toggle');
				if (!btn) return;
				const icons = btn.querySelectorAll('[data-theme-icon]');
				const paint = (mode) => {
					icons.forEach((el) => {
						el.hidden = el.dataset.themeIcon !== mode;
					});
					btn.title = { system: '시스템', light: '라이트', dark: '다크' }[mode];
				};
				let mode = localStorage.getItem('theme') ?? 'system';
				if (!ORDER.includes(mode)) mode = 'system';
				paint(mode);
				btn.addEventListener('click', () => {
					mode = ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length];
					if (mode === 'system') {
						delete document.documentElement.dataset.theme;
						localStorage.removeItem('theme');
					} else {
						document.documentElement.dataset.theme = mode;
						localStorage.setItem('theme', mode);
					}
					paint(mode);
				});
			})();
		</script>
	</body>
</html>

<style is:global>
	/* 토스 그레이 스케일 + 단일 블루 포인트.
	   면과 면은 선이 아니라 배경색 차이로 나눈다 */
	:root {
		--bg: #ffffff;
		--surface: #f9fafb;
		--fg: #191f28;
		--fg2: #4e5968;
		--fg3: #667080;
		--line: #f2f4f6;
		--blue: #3182f6;
		--blue-strong: #1b64da;
		--green: #166534;
		--r: 18px;
		--measure: 54rem;
		--pad: clamp(1rem, 4vw, 1.5rem);
	}
	/* 다크 값은 두 번 쓴다. 하나는 OS 설정용(@media 안), 하나는 수동 선택용.
	   @media 안의 규칙은 밖에서 재사용할 수 없어 합칠 방법이 없다.
	   :not([data-theme='light']) 가 있어야 OS가 다크여도 수동 라이트가 이긴다 */
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) {
			--bg: #17171c;
			--surface: #202127;
			--fg: #f9fafb;
			--fg2: #b0b8c1;
			--fg3: #8b95a1;
			--line: #2b2d36;
			--blue: #4593fc;
			--blue-strong: #4593fc;
			--green: #4ade80;
		}
	}
	:root[data-theme='dark'] {
		--bg: #17171c;
		--surface: #202127;
		--fg: #f9fafb;
		--fg2: #b0b8c1;
		--fg3: #8b95a1;
		--line: #2b2d36;
		--blue: #4593fc;
		--blue-strong: #4593fc;
		--green: #4ade80;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family:
			Pretendard, 'Pretendard Variable', system-ui, -apple-system,
			'Apple SD Gothic Neo', sans-serif;
		font-size: 16px;
		line-height: 1.7;
		letter-spacing: -0.018em;
		word-break: keep-all;
		overflow-wrap: break-word;
		-webkit-font-smoothing: antialiased;
	}

	/* 전역에서 header/footer 태그 셀렉터를 쓰지 않는다.
	   글 본문 안의 <header>까지 잡혀 제목 레이아웃이 깨진다 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0.9rem var(--pad);
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(16px);
	}
	.site-header .bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: var(--measure);
		margin: 0 auto;
	}
	.wordmark {
		font-size: 1.0625rem;
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.site-header nav {
		display: flex;
		gap: 0.35rem;
	}
	.navlink {
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		color: var(--fg3);
		font-size: 0.9375rem;
		font-weight: 600;
		transition: background 160ms ease, color 160ms ease;
	}
	.navlink:hover {
		background: var(--surface);
		color: var(--fg2);
	}
	.navlink.on {
		background: var(--surface);
		color: var(--fg);
	}
	.navlink.theme {
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.55rem;
		border: 0;
		background: transparent;
		font: inherit;
		cursor: pointer;
	}
	.navlink.theme:hover {
		background: var(--surface);
	}
	/* :not([hidden]) 이 없으면 display 가 hidden 속성을 덮어써 아이콘 3개가 다 보인다 */
	.navlink.theme span:not([hidden]) {
		display: inline-flex;
	}
	.navlink.theme svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	main {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 0 var(--pad) 5rem;
	}

	.site-footer {
		margin-top: 4rem;
		padding: 3.5rem var(--pad) 3rem;
		border-top: 1px solid var(--line);
	}
	.site-footer .cols {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr;
		gap: 2.5rem;
		max-width: var(--measure);
		margin: 0 auto;
	}
	.site-footer .name {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.site-footer .role {
		margin: 0.1rem 0 0;
		color: var(--fg3);
		font-size: 0.8125rem;
	}
	.site-footer .bio {
		margin: 1rem 0 0;
		max-width: 20rem;
		color: var(--fg3);
		font-size: 0.875rem;
		line-height: 1.65;
	}
	.site-footer .bio strong {
		color: var(--fg2);
		font-weight: 600;
	}
	.site-footer h2 {
		margin: 0 0 0.9rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.site-footer ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.site-footer li {
		margin-bottom: 0.6rem;
	}
	.site-footer li a {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--fg3);
		font-size: 0.875rem;
		transition: color 160ms ease;
	}
	.site-footer li a:hover {
		color: var(--fg);
	}
	.site-footer svg {
		width: 15px;
		height: 15px;
		flex-shrink: 0;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.site-footer .copy {
		max-width: var(--measure);
		margin: 3rem auto 0;
		color: var(--fg3);
		font-size: 0.8125rem;
	}

	@media (max-width: 40rem) {
		.site-footer .cols {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.site-footer .intro {
			grid-column: 1 / -1;
		}
	}

	/* ── 공통 조각 ───────────────────────────── */
	/* 카드 위에 붙는 작은 섹션 라벨 */
	.label {
		margin: 2.75rem 0 0.7rem;
		padding-left: 0.25rem;
		color: var(--fg3);
		font-size: 0.8125rem;
		font-weight: 700;
	}
	/* 라운드 카드. 선 대신 면으로 구분한다 */
	.card {
		border-radius: var(--r);
		background: var(--surface);
		overflow: hidden;
	}
	/* 카드 안 행 사이 구분선. 카드 끝까지 닿지 않고
	   행 좌우 패딩만큼 들여넣는다 (토스 리스트의 특징) */
	.card > * + * {
		position: relative;
	}
	.card > * + *::before {
		content: '';
		position: absolute;
		top: 0;
		left: 1.25rem;
		right: 1.25rem;
		height: 1px;
		background: var(--line);
	}

	h1,
	h2,
	h3 {
		line-height: 1.4;
		letter-spacing: -0.032em;
		font-weight: 700;
	}
	h2 {
		font-size: 1.25rem;
		margin: 2.75rem 0 0.75rem;
	}
	h3 {
		font-size: 1.0625rem;
		margin: 2rem 0 0.5rem;
	}
	p {
		margin: 0 0 1.25rem;
	}

	a {
		color: inherit;
		text-decoration: none;
		transition: opacity 160ms ease;
	}
	.site-footer a:hover {
		color: var(--fg2);
	}
	:focus-visible {
		outline: 2px solid var(--blue);
		outline-offset: 2px;
		border-radius: 6px;
	}

	/* ── 본문 요소 ───────────────────────────── */
	article a {
		color: var(--blue-strong);
		font-weight: 500;
	}
	pre {
		padding: 1.1rem 1.25rem;
		border-radius: 14px;
		overflow-x: auto;
		font-size: 0.875rem;
		line-height: 1.65;
		letter-spacing: 0;
	}
	/* astro.config.mjs 의 shiki 듀얼 테마에서 글자색만 가져오고,
	   배경은 카드와 같은 면색을 유지한다 (테마 배경을 쓰면 면이 사라진다) */
	.astro-code {
		background: var(--surface) !important;
	}
	.astro-code,
	.astro-code span {
		color: var(--shiki-light);
	}
	@media (prefers-color-scheme: dark) {
		.astro-code,
		.astro-code span {
			color: var(--shiki-dark);
		}
	}
	:not(pre) > code {
		padding: 0.15em 0.42em;
		border-radius: 6px;
		background: var(--line);
		color: var(--fg2);
		font-size: 0.875em;
		letter-spacing: 0;
	}
	blockquote {
		margin: 1.75rem 0;
		padding: 1rem 1.25rem;
		border-radius: 14px;
		background: var(--surface);
		color: var(--fg2);
	}
	blockquote p:last-child {
		margin-bottom: 0;
	}
	img {
		max-width: 100%;
		height: auto;
		border-radius: 14px;
	}
	hr {
		margin: 2.75rem 0;
		border: 0;
		border-top: 1px solid var(--line);
	}
	ul,
	ol {
		padding-left: 1.15rem;
	}
	li {
		margin-bottom: 0.35rem;
	}
	li::marker {
		color: var(--fg3);
	}
	/* 표는 좁은 화면에서 표 안에서만 가로 스크롤되게 한다.
	   그냥 두면 셀 최소폭 합이 뷰포트를 넘겨 페이지 전체가 밀린다.
	   마크다운이 만드는 <table>은 감쌀 수 없어 table 자체를 스크롤 상자로 쓴다 */
	table {
		display: block;
		width: 100%;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	th,
	td {
		padding: 0.65rem 0.85rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
	}
	th {
		color: var(--fg3);
		font-weight: 600;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
