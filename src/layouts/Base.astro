---
interface Props {
	title: string;
	description?: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
	{ href: '/', label: '포트폴리오' },
	{ href: '/blog', label: '블로그' },
];
const path = Astro.url.pathname;
// /posts/... 로 들어와도 헤더의 '블로그'가 켜져 있어야 한다
const inBlog = path === '/blog' || path.startsWith('/posts');
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="data:," />
	</head>
	<body>
		<header class="site-header">
			<div class="bar">
				<a href="/" class="wordmark">강경현</a>
				<nav>
					{
						nav.map((item) => {
							const on =
								item.href === '/blog' ? inBlog : item.href === path;
							return (
								<a
									href={item.href}
									class:list={['navlink', { on }]}
									aria-current={on ? 'page' : undefined}
								>
									{item.label}
								</a>
							);
						})
					}
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="cols">
				<div class="intro">
					<p class="name">강경현</p>
					<p class="role">Backend · Security</p>
					<p class="bio">
						경희대학교 컴퓨터공학과 3학년. 알고리즘과 시스템 보안을 파고,{' '}
						<strong>만든 걸 실제로 누가 쓰게 만드는 일</strong>을 좋아합니다.
					</p>
				</div>

				<div>
					<h2>Connect</h2>
					<ul>
						<li>
							<a href="https://github.com/kangkyunghyun">
								<svg viewBox="0 0 24 24" aria-hidden="true"
									><path
										d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
									></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
								>GitHub
							</a>
						</li>
						<li>
							<a href="https://www.linkedin.com/in/kangkyunghyun/">
								<svg viewBox="0 0 24 24" aria-hidden="true"
									><path
										d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
									></path><rect width="4" height="12" x="2" y="9"
									></rect><circle cx="4" cy="4" r="2"></circle></svg
								>LinkedIn
							</a>
						</li>
						<li>
							<a href="/blog">
								<svg viewBox="0 0 24 24" aria-hidden="true"
									><path d="M12 7v14"></path><path
										d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"
									></path></svg
								>블로그
							</a>
						</li>
						<li>
							<a href="https://khyunx.tistory.com">
								<svg viewBox="0 0 24 24" aria-hidden="true"
									><path
										d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
									></path></svg
								>이전 블로그
							</a>
						</li>
						<li>
							<a href="mailto:kyunghyun.dev@gmail.com">
								<svg viewBox="0 0 24 24" aria-hidden="true"
									><rect width="20" height="16" x="2" y="4" rx="2"
									></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
									></path></svg
								>Email
							</a>
						</li>
					</ul>
				</div>

				<div>
					<h2>Quick Links</h2>
					<ul>
						<li><a href="/#stacks">Tech Stacks</a></li>
						<li><a href="/#activity">Activity</a></li>
						<li><a href="/#projects">Projects</a></li>
						<li><a href="/#awards">Awards</a></li>
						<li><a href="/#links">Links</a></li>
					</ul>
				</div>
			</div>
			<p class="copy">© 2026 강경현. All rights reserved.</p>
		</footer>
	</body>
</html>

<style is:global>
	/* 토스 그레이 스케일 + 단일 블루 포인트.
	   면과 면은 선이 아니라 배경색 차이로 나눈다 */
	:root {
		--bg: #ffffff;
		--surface: #f9fafb;
		--fg: #191f28;
		--fg2: #4e5968;
		--fg3: #8b95a1;
		--line: #f2f4f6;
		--blue: #3182f6;
		--r: 18px;
		--measure: 54rem;
		--pad: clamp(1rem, 4vw, 1.5rem);
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #17171c;
			--surface: #202127;
			--fg: #f9fafb;
			--fg2: #b0b8c1;
			--fg3: #6b7684;
			--line: #2b2d36;
			--blue: #4593fc;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family:
			Pretendard, 'Pretendard Variable', system-ui, -apple-system,
			'Apple SD Gothic Neo', sans-serif;
		font-size: 16px;
		line-height: 1.7;
		letter-spacing: -0.018em;
		word-break: keep-all;
		overflow-wrap: break-word;
		-webkit-font-smoothing: antialiased;
	}

	/* 전역에서 header/footer 태그 셀렉터를 쓰지 않는다.
	   글 본문 안의 <header>까지 잡혀 제목 레이아웃이 깨진다 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0.9rem var(--pad);
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(16px);
	}
	.site-header .bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: var(--measure);
		margin: 0 auto;
	}
	.wordmark {
		font-size: 1.0625rem;
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.site-header nav {
		display: flex;
		gap: 0.35rem;
	}
	.navlink {
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		color: var(--fg3);
		font-size: 0.9375rem;
		font-weight: 600;
		transition: background 160ms ease, color 160ms ease;
	}
	.navlink:hover {
		background: var(--surface);
		color: var(--fg2);
	}
	.navlink.on {
		background: var(--surface);
		color: var(--fg);
	}

	main {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 0 var(--pad) 5rem;
	}

	.site-footer {
		margin-top: 4rem;
		padding: 3.5rem var(--pad) 3rem;
		border-top: 1px solid var(--line);
	}
	.site-footer .cols {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr;
		gap: 2.5rem;
		max-width: var(--measure);
		margin: 0 auto;
	}
	.site-footer .name {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.site-footer .role {
		margin: 0.1rem 0 0;
		color: var(--fg3);
		font-size: 0.8125rem;
	}
	.site-footer .bio {
		margin: 1rem 0 0;
		max-width: 20rem;
		color: var(--fg3);
		font-size: 0.875rem;
		line-height: 1.65;
	}
	.site-footer .bio strong {
		color: var(--fg2);
		font-weight: 600;
	}
	.site-footer h2 {
		margin: 0 0 0.9rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.site-footer ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.site-footer li {
		margin-bottom: 0.6rem;
	}
	.site-footer li a {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--fg3);
		font-size: 0.875rem;
		transition: color 160ms ease;
	}
	.site-footer li a:hover {
		color: var(--fg);
	}
	.site-footer svg {
		width: 15px;
		height: 15px;
		flex-shrink: 0;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.site-footer .copy {
		max-width: var(--measure);
		margin: 3rem auto 0;
		color: var(--fg3);
		font-size: 0.8125rem;
	}

	@media (max-width: 40rem) {
		.site-footer .cols {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.site-footer .intro {
			grid-column: 1 / -1;
		}
	}

	/* ── 공통 조각 ───────────────────────────── */
	/* 카드 위에 붙는 작은 섹션 라벨 */
	.label {
		margin: 2.75rem 0 0.7rem;
		padding-left: 0.25rem;
		color: var(--fg3);
		font-size: 0.8125rem;
		font-weight: 700;
	}
	/* 라운드 카드. 선 대신 면으로 구분한다 */
	.card {
		border-radius: var(--r);
		background: var(--surface);
		overflow: hidden;
	}
	/* 카드 안 행 사이 구분선. 카드 끝까지 닿지 않고
	   행 좌우 패딩만큼 들여넣는다 (토스 리스트의 특징) */
	.card > * + * {
		position: relative;
	}
	.card > * + *::before {
		content: '';
		position: absolute;
		top: 0;
		left: 1.25rem;
		right: 1.25rem;
		height: 1px;
		background: var(--line);
	}

	h1,
	h2,
	h3 {
		line-height: 1.4;
		letter-spacing: -0.032em;
		font-weight: 700;
	}
	h2 {
		font-size: 1.25rem;
		margin: 2.75rem 0 0.75rem;
	}
	h3 {
		font-size: 1.0625rem;
		margin: 2rem 0 0.5rem;
	}
	p {
		margin: 0 0 1.25rem;
	}

	a {
		color: inherit;
		text-decoration: none;
		transition: opacity 160ms ease;
	}
	.site-footer a:hover {
		color: var(--fg2);
	}
	:focus-visible {
		outline: 2px solid var(--blue);
		outline-offset: 2px;
		border-radius: 6px;
	}

	/* ── 본문 요소 ───────────────────────────── */
	article a {
		color: var(--blue);
		font-weight: 500;
	}
	pre {
		padding: 1.1rem 1.25rem;
		border-radius: 14px;
		overflow-x: auto;
		font-size: 0.875rem;
		line-height: 1.65;
		letter-spacing: 0;
	}
	/* astro.config.mjs 의 shiki 듀얼 테마에서 글자색만 가져오고,
	   배경은 카드와 같은 면색을 유지한다 (테마 배경을 쓰면 면이 사라진다) */
	.astro-code {
		background: var(--surface) !important;
	}
	.astro-code,
	.astro-code span {
		color: var(--shiki-light);
	}
	@media (prefers-color-scheme: dark) {
		.astro-code,
		.astro-code span {
			color: var(--shiki-dark);
		}
	}
	:not(pre) > code {
		padding: 0.15em 0.42em;
		border-radius: 6px;
		background: var(--line);
		color: var(--fg2);
		font-size: 0.875em;
		letter-spacing: 0;
	}
	blockquote {
		margin: 1.75rem 0;
		padding: 1rem 1.25rem;
		border-radius: 14px;
		background: var(--surface);
		color: var(--fg2);
	}
	blockquote p:last-child {
		margin-bottom: 0;
	}
	img {
		max-width: 100%;
		height: auto;
		border-radius: 14px;
	}
	hr {
		margin: 2.75rem 0;
		border: 0;
		border-top: 1px solid var(--line);
	}
	ul,
	ol {
		padding-left: 1.15rem;
	}
	li {
		margin-bottom: 0.35rem;
	}
	li::marker {
		color: var(--fg3);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	th,
	td {
		padding: 0.65rem 0.85rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
	}
	th {
		color: var(--fg3);
		font-weight: 600;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
