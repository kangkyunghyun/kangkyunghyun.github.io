---
interface Props {
	title: string;
	description?: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
	{ href: '/', label: '글' },
	{ href: '/about', label: '소개' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="data:," />
	</head>
	<body>
		<header class="site-header">
			<div class="bar">
				<a href="/" class="wordmark">강경현</a>
				<nav>
					{
						nav.map((item) => (
							<a
								href={item.href}
								class:list={['navlink', { on: item.href === path }]}
								aria-current={item.href === path ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<a href="https://github.com/kangkyunghyun">GitHub</a>
			<a href="https://khyunx.tistory.com">이전 블로그</a>
		</footer>
	</body>
</html>

<style is:global>
	/* 토스 그레이 스케일 + 단일 블루 포인트.
	   면과 면은 선이 아니라 배경색 차이로 나눈다 */
	:root {
		--bg: #ffffff;
		--surface: #f9fafb;
		--fg: #191f28;
		--fg2: #4e5968;
		--fg3: #8b95a1;
		--line: #f2f4f6;
		--blue: #3182f6;
		--r: 18px;
		--measure: 42rem;
		--pad: clamp(1rem, 4vw, 1.5rem);
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #17171c;
			--surface: #202127;
			--fg: #f9fafb;
			--fg2: #b0b8c1;
			--fg3: #6b7684;
			--line: #2b2d36;
			--blue: #4593fc;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family:
			Pretendard, 'Pretendard Variable', system-ui, -apple-system,
			'Apple SD Gothic Neo', sans-serif;
		font-size: 16px;
		line-height: 1.7;
		letter-spacing: -0.018em;
		word-break: keep-all;
		overflow-wrap: break-word;
		-webkit-font-smoothing: antialiased;
	}

	/* 전역에서 header/footer 태그 셀렉터를 쓰지 않는다.
	   글 본문 안의 <header>까지 잡혀 제목 레이아웃이 깨진다 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0.9rem var(--pad);
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(16px);
	}
	.site-header .bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 56rem;
		margin: 0 auto;
	}
	.wordmark {
		font-size: 1.0625rem;
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.site-header nav {
		display: flex;
		gap: 0.35rem;
	}
	.navlink {
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		color: var(--fg3);
		font-size: 0.9375rem;
		font-weight: 600;
		transition: background 160ms ease, color 160ms ease;
	}
	.navlink:hover {
		background: var(--surface);
		color: var(--fg2);
	}
	.navlink.on {
		background: var(--surface);
		color: var(--fg);
	}

	main {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 0 var(--pad) 5rem;
	}

	.site-footer {
		display: flex;
		gap: 1.25rem;
		max-width: var(--measure);
		margin: 0 auto;
		padding: 2rem var(--pad) 3.5rem;
		color: var(--fg3);
		font-size: 0.875rem;
		font-weight: 500;
	}

	/* ── 공통 조각 ───────────────────────────── */
	/* 카드 위에 붙는 작은 섹션 라벨 */
	.label {
		margin: 2.75rem 0 0.7rem;
		padding-left: 0.25rem;
		color: var(--fg3);
		font-size: 0.8125rem;
		font-weight: 700;
	}
	/* 라운드 카드. 선 대신 면으로 구분한다 */
	.card {
		border-radius: var(--r);
		background: var(--surface);
		overflow: hidden;
	}
	/* 카드 안 행 사이 구분선. 카드 끝까지 닿지 않고
	   행 좌우 패딩만큼 들여넣는다 (토스 리스트의 특징) */
	.card > * + * {
		position: relative;
	}
	.card > * + *::before {
		content: '';
		position: absolute;
		top: 0;
		left: 1.25rem;
		right: 1.25rem;
		height: 1px;
		background: var(--line);
	}

	h1,
	h2,
	h3 {
		line-height: 1.4;
		letter-spacing: -0.032em;
		font-weight: 700;
	}
	h2 {
		font-size: 1.25rem;
		margin: 2.75rem 0 0.75rem;
	}
	h3 {
		font-size: 1.0625rem;
		margin: 2rem 0 0.5rem;
	}
	p {
		margin: 0 0 1.25rem;
	}

	a {
		color: inherit;
		text-decoration: none;
		transition: opacity 160ms ease;
	}
	.site-footer a:hover {
		color: var(--fg2);
	}
	:focus-visible {
		outline: 2px solid var(--blue);
		outline-offset: 2px;
		border-radius: 6px;
	}

	/* ── 본문 요소 ───────────────────────────── */
	article a {
		color: var(--blue);
		font-weight: 500;
	}
	pre {
		padding: 1.1rem 1.25rem;
		border-radius: 14px;
		overflow-x: auto;
		font-size: 0.875rem;
		line-height: 1.65;
		letter-spacing: 0;
	}
	/* astro.config.mjs 의 shiki 듀얼 테마에서 글자색만 가져오고,
	   배경은 카드와 같은 면색을 유지한다 (테마 배경을 쓰면 면이 사라진다) */
	.astro-code {
		background: var(--surface) !important;
	}
	.astro-code,
	.astro-code span {
		color: var(--shiki-light);
	}
	@media (prefers-color-scheme: dark) {
		.astro-code,
		.astro-code span {
			color: var(--shiki-dark);
		}
	}
	:not(pre) > code {
		padding: 0.15em 0.42em;
		border-radius: 6px;
		background: var(--line);
		color: var(--fg2);
		font-size: 0.875em;
		letter-spacing: 0;
	}
	blockquote {
		margin: 1.75rem 0;
		padding: 1rem 1.25rem;
		border-radius: 14px;
		background: var(--surface);
		color: var(--fg2);
	}
	blockquote p:last-child {
		margin-bottom: 0;
	}
	img {
		max-width: 100%;
		height: auto;
		border-radius: 14px;
	}
	hr {
		margin: 2.75rem 0;
		border: 0;
		border-top: 1px solid var(--line);
	}
	ul,
	ol {
		padding-left: 1.15rem;
	}
	li {
		margin-bottom: 0.35rem;
	}
	li::marker {
		color: var(--fg3);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	th,
	td {
		padding: 0.65rem 0.85rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
	}
	th {
		color: var(--fg3);
		font-weight: 600;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
