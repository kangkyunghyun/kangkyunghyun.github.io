---
interface Props {
	title: string;
	description?: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
	{ href: '/', label: '글' },
	{ href: '/about', label: '소개' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="data:," />
	</head>
	<body>
		<header class="site-header">
			<div class="bar">
				<a href="/" class="wordmark">KANGKYUNGHYUN</a>
				<nav>
					{
						nav.map((item) => (
							<a
								href={item.href}
								aria-current={item.href === path ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
					<a href="https://github.com/kangkyunghyun">GitHub</a>
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<span>© 강경현</span>
			<a href="https://khyunx.tistory.com">이전 블로그</a>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--fg: #09090b;
		--dim: #52525b;
		--bg: #fafafa;
		--line: #e4e4e7;
		--measure: 44rem;
		--pad: clamp(1.25rem, 5vw, 2.5rem);
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--fg: #fafafa;
			--dim: #a1a1aa;
			--bg: #0c0c0e;
			--line: #27272a;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family:
			Pretendard, 'Pretendard Variable', system-ui, -apple-system,
			'Apple SD Gothic Neo', sans-serif;
		font-size: 17px;
		line-height: 1.8;
		letter-spacing: -0.011em;
		word-break: keep-all;
		overflow-wrap: break-word;
		-webkit-font-smoothing: antialiased;
	}

	/* ── 사이트 헤더 ─────────────────────────── */
	/* 반드시 .site-header 로 좁힐 것 — 그냥 `header` 로 두면
	   글 본문 안의 <header> 까지 잡아서 제목 레이아웃이 깨진다 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 1.1rem var(--pad);
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(12px);
	}
	.site-header .bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 64rem;
		margin: 0 auto;
	}
	.wordmark {
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}
	.site-header nav {
		display: flex;
		gap: 1.5rem;
		font-size: 0.875rem;
		font-weight: 500;
	}
	.site-header nav a[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 5px;
	}

	main {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 0 var(--pad) 8rem;
	}

	.site-footer {
		display: flex;
		justify-content: space-between;
		max-width: var(--measure);
		margin: 0 auto;
		padding: 2rem var(--pad) 4rem;
		border-top: 1px solid var(--line);
		color: var(--dim);
		font-size: 0.8125rem;
	}

	/* ── 타이포 ──────────────────────────────── */
	h1,
	h2,
	h3 {
		line-height: 1.3;
		letter-spacing: -0.03em;
		font-weight: 700;
	}
	h2 {
		font-size: 1.3rem;
		margin: 3.5rem 0 1rem;
	}
	h3 {
		font-size: 1.0625rem;
		margin: 2.5rem 0 0.75rem;
	}
	p {
		margin: 0 0 1.4rem;
	}

	a {
		color: inherit;
		text-decoration: none;
		transition: opacity 180ms ease;
	}
	a:hover {
		opacity: 0.55;
	}
	main article a,
	main p a {
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--line);
	}
	:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
		border-radius: 2px;
	}

	time {
		color: var(--dim);
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0;
	}

	/* ── 본문 요소 ───────────────────────────── */
	pre {
		padding: 1.1rem 1.25rem;
		background: color-mix(in srgb, var(--fg) 4%, transparent);
		border: 1px solid var(--line);
		border-radius: 4px;
		overflow-x: auto;
		font-size: 0.875rem;
		line-height: 1.7;
		letter-spacing: 0;
	}
	:not(pre) > code {
		padding: 0.15em 0.4em;
		background: color-mix(in srgb, var(--fg) 7%, transparent);
		border-radius: 3px;
		font-size: 0.875em;
		letter-spacing: 0;
	}
	blockquote {
		margin: 2rem 0;
		padding-left: 1.25rem;
		border-left: 2px solid var(--fg);
		color: var(--dim);
	}
	img {
		max-width: 100%;
		height: auto;
		border-radius: 4px;
	}
	hr {
		margin: 3.5rem 0;
		border: 0;
		border-top: 1px solid var(--line);
	}
	ul,
	ol {
		padding-left: 1.2rem;
	}
	li {
		margin-bottom: 0.4rem;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	th,
	td {
		padding: 0.6rem 0.8rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
	}
	th {
		font-weight: 600;
	}
	/* 표·코드가 넘쳐도 페이지 전체는 안 밀리게 */
	.scroll-x {
		overflow-x: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
